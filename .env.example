# ─── Supabase (اختياري - غير مستخدم حالياً) ────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── AI API (Lovable AI Gateway أو OpenAI أو أي مزود متوافق) ───────────────
# احصل على مفتاح Lovable AI من: https://lovable.dev
# أو استخدم OpenAI: https://platform.openai.com/api-keys
VITE_AI_API_KEY=your-ai-api-key-here

# نقطة النهاية (افتراضي: Lovable AI Gateway)
VITE_AI_BASE_URL=https://ai.gateway.lovable.dev/v1

# اسم النموذج (افتراضي: gemini-3-flash-preview)
VITE_AI_MODEL=google/gemini-3-flash-preview
