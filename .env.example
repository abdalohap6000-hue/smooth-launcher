# ─── Supabase (يوفرها Lovable Cloud تلقائياً) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ─── نموذج الذكاء الاصطناعي الافتراضي ──────────────────────────────────────
# قيمة يستخدمها المتصفح كافتراضي، ويمكن للمستخدم تغييرها من صفحة الإعدادات.
VITE_AI_MODEL=google/gemini-3-flash-preview

# ─── ملاحظة أمنية ─────────────────────────────────────────────────────────
# مفتاح AI (LOVABLE_API_KEY) لا يُوضع هنا نهائياً — يُخزَّن كسر على الخادم
# في Supabase Edge Function Secrets، ويستدعيه Edge Function `generate-content`
# نيابةً عن المتصفح. لا تضعه أبداً في متغير يبدأ بـ VITE_ لأنه سيتسرّب للعميل.
